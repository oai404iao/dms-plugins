{
    "id": "lyrics",
    "name": "Bilingual Lyrics",
    "description": "Shared synced lyrics and display settings for the customized native media widget and page",
    "version": "0.4.0-local.1",
    "author": "gmaaa",
    "icon": "lyrics",
    "type": "daemon",
    "capabilities": [],
    "component": "./LyricsService.qml",
    "settings": "./LyricsSettings.qml",
    "settings_schema": {
        "lyricsSource": {
            "type": "string",
            "default": "netease"
        },
        "maxWidth": {
            "type": "integer",
            "default": 280,
            "minimum": 80,
            "maximum": 600
        },
        "showLyrics": {
            "type": "boolean",
            "default": true
        },
        "showTranslation": {
            "type": "boolean",
            "default": true
        },
        "translationLanguage": {
            "type": "string",
            "default": "source"
        }
    },
    "requires": [],
    "requires_dms": ">=1.6.2",
    "permissions": [
        "settings_read",
        "settings_write",
        "network"
    ]
}
